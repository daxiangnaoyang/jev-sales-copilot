{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jev 销售副驾",
  "version": "0.0.1",
  "identifier": "com.daxiang.jev-sales-copilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jev 销售副驾",
        "width": 1360,
        "height": 860,
        "minWidth": 940,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 https:; worker-src 'self' blob: https:; media-src 'self' https: blob:; font-src 'self' data:; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    }
  }
}
